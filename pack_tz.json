    {
      "id": "KB1",
      "topic": "cholera_report",
      "source": "HSSP V (placeholder)",
      "text": "Priority disease alerts such as cholera must be reported to the District Medical Officer within 24 hours and the district response team activated.",
      "status": "placeholder"
    },
    {
      "id": "KB2",
      "topic": "cholera_wash",
      "source": "WHO cholera guidance (placeholder)",
      "text": "Cholera response combines case management, safe water, sanitation and hygiene, community engagement and oral cholera vaccine where indicated.",
      "status": "placeholder"
    },
    {
      "id": "KB3",
      "topic": "privacy",
      "source": "PDPA 2022 (placeholder)",
      "text": "Personal health data needs a lawful basis, must be limited to what is necessary and must be protected. Aggregated or anonymised data carries lower risk.",
      "status": "placeholder"
    },
    {
      "id": "KB4",
      "topic": "sharing",
      "source": "PDPA 2022 (placeholder)",
      "text": "Sharing personal data with third parties or across borders needs safeguards and a documented legal basis.",
      "status": "placeholder"
    },
    {
      "id": "KB5",
      "topic": "immunization",
      "source": "HSSP V (placeholder)",
      "text": "Immunization gaps are addressed through outreach and mop up campaigns in low coverage wards using routine DHIS2 coverage data.",
      "status": "placeholder"
    },
    {
      "id": "KB6",
      "topic": "stockout",
      "source": "HSSP V (placeholder)",
      "text": "Essential medicine stockouts are escalated to the regional medical store with a replenishment plan.",
      "status": "placeholder"
    },
    {
      "id": "KB7",
      "topic": "maternal",
      "source": "HSSP V (placeholder)",
      "text": "Maternal emergencies require referral, skilled birth attendance and emergency obstetric care with community transport support.",
      "status": "placeholder"
    },
    {
      "id": "KB8",
      "topic": "ussd",
      "source": "TCRA guidance (placeholder)",
      "text": "Mobile services such as USSD must use approved shortcodes from the telecommunications regulator and protect subscriber data.",
      "status": "placeholder"
    },
    {
      "id": "KB9",
      "topic": "digital",
      "source": "Vision 2050 (placeholder)",
      "text": "Digital health tools should expand access in rural areas and reduce inequality.",
      "status": "placeholder"
    }
  ],
